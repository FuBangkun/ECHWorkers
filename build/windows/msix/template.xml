<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ech-workers.exe"
        Arguments=""
        InstallLocation="C:\Program Files\FuBangkun\ECHWorkers">
    </Installer>
    <PackageInformation
        PackageName="ECHWorkers"
        PackageDisplayName="ECHWorkers"
        PublisherName="CN=FuBANGKUN"
        PublisherDisplayName="FuBangkun"
        Version="0.1.0.0"
        PackageDescription="A ech-workers application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.fubangkun.echworkers"
                Description="A ech-workers application"
                DisplayName="ECHWorkers"
                ExecutableName="ech-workers.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ECHWorkers</DisplayName>
            <PublisherDisplayName>FuBangkun</PublisherDisplayName>
            <Description>A ech-workers application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ech-workers.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
